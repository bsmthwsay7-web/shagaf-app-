<div class="w-full max-w-md bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200 flex flex-col h-[85vh]">
    
    <!-- Header -->
    <div class="bg-sky-600 text-white p-4 flex justify-between items-center shadow-md">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-graduation-cap text-xl"></i>
            <h1 class="font-extrabold text-base">منصة شغف المدرسية</h1>
        </div>
        <span id="userBadge" class="text-[11px] bg-white/20 px-3 py-1 rounded-full font-bold">زائرة</span>
    </div>

    <!-- Content Area -->
    <div id="appBody" class="p-4 flex-1 overflow-y-auto space-y-4">
        <!-- Dynamic Content -->
    </div>

    <!-- Creators Attribution Footer -->
    <div class="bg-sky-50 border-t border-sky-100 py-2.5 px-3 text-center text-[11px] text-sky-800 font-bold">
        ✨ صاحبات المشروع والقلوب: بسمة دان يوسف & بسمة بدماسي ✨
    </div>
</div>

<script>
    let currentUser = JSON.parse(localStorage.getItem('shagaf_user') || 'null');
    let activities = JSON.parse(localStorage.getItem('shagaf_acts') || JSON.stringify([
        { id: 1, title: 'ورشة الذكاء الاصطناعي والبرمجة', type: 'فعالية', teacher: 'أ. نورة', icon: 'fa-code' },
        { id: 2, title: 'مسابقة الإبداع العلمي', type: 'مسابقة', teacher: 'أ. سارة', icon: 'fa-flask' }
    ]));

    function save() {
        localStorage.setItem('shagaf_user', JSON.stringify(currentUser));
        localStorage.setItem('shagaf_acts', JSON.stringify(activities));
        render();
    }

    function render() {
        const body = document.getElementById('appBody');
        const badge = document.getElementById('userBadge');

        if (!currentUser) {
            badge.textContent = 'تسجيل الدخول';
            body.innerHTML = `
                <div class="text-center py-4 space-y-4">
                    <div class="w-16 h-16 bg-sky-100 text-sky-600 rounded-full flex items-center justify-center mx-auto text-2xl shadow-inner">
                        <i class="fa-solid fa-school"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-sky-700">أهلاً بكِ في شغف</h2>
                        <p class="text-xs text-slate-500 mt-1">شاركي، بادري، واصنعي أثرًا مدرسيًا.</p>
                    </div>
                    <div class="space-y-3 bg-slate-50 p-4 rounded-2xl border border-slate-100">
                        <input id="nameInput" type="text" placeholder="أدخلي اسمكِ الكامل" class="w-full p-2.5 border rounded-xl text-xs focus:outline-none focus:border-sky-500">
                        <div class="grid grid-cols-2 gap-2">
                            <button onclick="login('student')" class="bg-sky-600 text-white py-2.5 rounded-xl text-xs font-bold shadow hover:bg-sky-700"><i class="fa-solid fa-user-graduate ml-1"></i> طالبة</button>
                            <button onclick="login('teacher')" class="bg-slate-800 text-white py-2.5 rounded-xl text-xs font-bold shadow hover:bg-slate-900"><i class="fa-solid fa-chalkboard-user ml-1"></i> معلمة</button>
                        </div>
                    </div>
                </div>
            `;
            return;
        }

        badge.textContent = currentUser.name + (currentUser.role === 'student' ? ' (طالبة)' : ' (معلمة)');
        
        if (currentUser.role === 'student') {
            body.innerHTML = `
                <div class="space-y-3">
                    <div class="flex justify-between items-center border-b pb-2">
                        <span class="font-bold text-xs text-slate-700"><i class="fa-solid fa-list-check ml-1 text-sky-600"></i> الأنشطة والمسابقات المدرسية</span>
                        <button onclick="logout()" class="text-xs text-rose-500 font-bold hover:underline">خروج</button>
                    </div>
                    ${activities.map(a => `
                        <div class="bg-sky-50/60 p-3.5 rounded-2xl border border-sky-100 flex justify-between items-center shadow-sm">
                            <div class="flex items-center gap-3"><div class="w-9 h-9 rounded-xl bg-white text-sky-600 flex items-center justify-center shadow-sm">
                                    <i class="fa-solid ${a.icon || 'fa-book-open'}"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-xs text-slate-800">${a.title}</h4>
                                    <span class="text-[10px] text-slate-500">إشراف المعلمة: ${a.teacher}</span>
                                </div>
                            </div>
                            <button onclick="alert('تم تسجيل مشاركتكِ بنجاح!')" class="bg-sky-600 hover:bg-sky-700 text-white text-[10px] px-3 py-1.5 rounded-xl font-bold shadow">مشاركة</button>
                        </div>
                    `).join('')}
                </div>
            `;
        } else {
            body.innerHTML = `
                <div class="space-y-3">
                    <div class="flex justify-between items-center border-b pb-2">
                        <span class="font-bold text-xs text-slate-700"><i class="fa-solid fa-pen-to-square ml-1 text-sky-600"></i> لوحة المعلمة - إضافة نشاط</span>
                        <button onclick="logout()" class="text-xs text-rose-500 font-bold hover:underline">خروج</button>
                    </div>
                    <div class="space-y-2 bg-slate-50 p-3 rounded-2xl border border-slate-100">
                        <input id="actTitle" type="text" placeholder="عنوان النشاط أو المسابقة المدرسية" class="w-full p-2.5 border rounded-xl text-xs">
                        <button onclick="addActivity()" class="w-full bg-sky-600 hover:bg-sky-700 text-white py-2 rounded-xl text-xs font-bold shadow"><i class="fa-solid fa-plus ml-1"></i> نشر النشاط للطالبات</button>
                    </div>
                    <div class="pt-2"><h4 class="font-bold text-xs text-slate-700 mb-2"><i class="fa-solid fa-folder-open ml-1 text-slate-500"></i> الأنشطة الحالية:</h4></div>
                    <div class="space-y-1.5">
                        ${activities.map(a => `<div class="bg-white p-2.5 rounded-xl border text-xs text-slate-700 flex items-center gap-2"><i class="fa-solid fa-check text-emerald-500 text-xs"></i> ${a.title}</div>`).join('')}
                    </div>
                </div>
            `;
        }
    }

    function login(role) {
        const name = document.getElementById('nameInput').value.trim();
        if (!name) { alert('الرجاء إدخال الاسم!'); return; }
        currentUser = { name, role };
        save();
    }

    function addActivity() {
        const title = document.getElementById('actTitle').value.trim();
        if (!title) { alert('اكتب عنوان النشاط!'); return; }
        activities.push({ id: Date.now(), title, teacher: currentUser.name, icon: 'fa-award' });
        save();
    }

    function logout() {
        currentUser = null;
        save();
    }

    render();
</script>
